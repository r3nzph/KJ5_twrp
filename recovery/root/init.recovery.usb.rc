# Copyright (c) 2011-2016, The Linux Foundation.
# Minimal MT6768 Recovery USB Fix

import /init.recovery.mt6768.rc

on early-init
    write /sys/module/block/parameters/events_dfl_poll_msecs 1000

on init
    mkdir /config 0771 root shell
    mount configfs none /config

    mkdir /config/usb_gadget/g1 0770 shell shell

    write /config/usb_gadget/g1/idVendor 0x2717
    write /config/usb_gadget/g1/idProduct 0xff68

    write /config/usb_gadget/g1/bcdDevice 0x0409
    write /config/usb_gadget/g1/bcdUSB 0x0200

    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell

    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer "Tecno"
    write /config/usb_gadget/g1/strings/0x409/product "TWRP"

    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/mtp.gs0

    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell

    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500

    symlink /config/usb_gadget/g1/functions/mtp.gs0 \
        /config/usb_gadget/g1/configs/b.1/f1

    symlink /config/usb_gadget/g1/functions/ffs.adb \
        /config/usb_gadget/g1/configs/b.1/f2

    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell

    mount functionfs adb /dev/usb-ffs/adb \
        uid=2000,gid=2000,rmode=0770,fmode=0660

    setprop sys.usb.configfs 1

on boot
    setprop sys.usb.controller musb-hdrc
    setprop sys.usb.config mtp,adb

    write /config/usb_gadget/g1/UDC musb-hdrc

    setprop sys.usb.state mtp,adb
