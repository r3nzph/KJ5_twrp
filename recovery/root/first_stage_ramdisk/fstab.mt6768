# =========================
# SYSTEM (SAFE FIRST STAGE)
# =========================

system /system erofs ro wait,slotselect,logical,first_stage_mount
system /system ext4 ro wait,slotselect,logical,first_stage_mount

system_ext /system_ext erofs ro wait,slotselect,logical,first_stage_mount
system_ext /system_ext ext4 ro wait,slotselect,logical,first_stage_mount

vendor /vendor erofs ro wait,slotselect,logical,first_stage_mount
vendor /vendor ext4 ro wait,slotselect,logical,first_stage_mount

product /product erofs ro wait,slotselect,logical,first_stage_mount
product /product ext4 ro wait,slotselect,logical,first_stage_mount

# =========================
# METADATA (KEEP CRITICAL ONLY)
# =========================

/dev/block/by-name/metadata /metadata ext4 noatime,nosuid,nodev,discard wait,check,formattable,first_stage_mount

# =========================
# DATA (KEEP, BUT NO EXTRA FLAGS)
# =========================

/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard wait,check,formattable,latemount

# =========================
# BASIC TRANFS (SAFE ONLY IF USED)
# =========================

/dev/block/by-name/tranfs /tranfs ext4 noatime,nosuid,nodev,discard wait,check,formattable,nofail

# =========================
# PERSISTENT MTK (REMOVE FIRST STAGE MOUNTING)
# =========================

/dev/block/by-name/protect1 /mnt/vendor/protect_f ext4 noatime,nosuid,nodev,commit=1,nodelalloc wait,check,formattable
/dev/block/by-name/protect2 /mnt/vendor/protect_s ext4 noatime,nosuid,nodev,commit=1,nodelalloc wait,check,formattable
/dev/block/by-name/nvdata /mnt/vendor/nvdata ext4 noatime,nosuid,nodev,commit=1,nodelalloc wait,check,formattable
/dev/block/by-name/nvcfg /mnt/vendor/nvcfg ext4 noatime,nosuid,nodev,commit=1,nodelalloc wait,check,formattable
/dev/block/by-name/persist /mnt/vendor/persist ext4 noatime,nosuid,nodev,commit=1,nodelalloc wait,check,formattable

# =========================
# RAW PARTITIONS (NO FIRST STAGE MOUNT)
# =========================

/dev/block/by-name/frp /frp emmc defaults defaults
/dev/block/by-name/nvram /nvram emmc defaults defaults
/dev/block/by-name/proinfo /proinfo emmc defaults defaults
/dev/block/by-name/misc /misc emmc defaults defaults
/dev/block/by-name/para /para emmc defaults defaults
