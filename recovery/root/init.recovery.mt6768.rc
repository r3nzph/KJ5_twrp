import /vibrator-KJ5.rc

# =========================
# INIT
# =========================
on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 1

    # Prevent broken early enumeration
    setprop sys.usb.state none

# =========================
# FS
# =========================
on fs
    # keep minimal for MTK stability
    mkdir /dev/.kmsg 0755 root root

# =========================
# POST-FS-DATA
# =========================
on post-fs-data
    # storage should now be available

    # create mtp node safely
    mkdir /config 0770 root shell
    mkdir /config/usb_gadget 0770 root shell

# =========================
# BOOT
# =========================
on boot
    start health-hal-2-1
    start boot-hal-1-2

# =========================
# LATE INIT (SAFE USB START)
# =========================
on late-init
    # Start adb AFTER mounts stabilize
    start adbd

    # Enable MTP + ADB
    setprop persist.sys.usb.config mtp,adb
    setprop sys.usb.config mtp,adb

    # MTK musb stability fix
    write /sys/class/udc/musb-hdrc/device/cmode 2

# =========================
# PROPERTY TRIGGERS
# =========================
on property:sys.usb.config=mtp,adb
    setprop sys.usb.state mtp,adb

on property:sys.usb.config=adb
    setprop sys.usb.state adb