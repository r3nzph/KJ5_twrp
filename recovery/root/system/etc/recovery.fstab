# =====================================================
# Dynamic Partitions
# =====================================================

system       /system       erofs   ro    wait,logical,first_stage_mount,slotselect
system       /system       ext4    ro    wait,logical,first_stage_mount,slotselect

system_ext   /system_ext   erofs   ro    wait,logical,first_stage_mount,slotselect
system_ext   /system_ext   ext4    ro    wait,logical,first_stage_mount,slotselect

vendor       /vendor       erofs   ro    wait,logical,first_stage_mount,slotselect
vendor       /vendor       ext4    ro    wait,logical,first_stage_mount,slotselect

product      /product      erofs   ro    wait,logical,first_stage_mount,slotselect
product      /product      ext4    ro    wait,logical,first_stage_mount,slotselect

# =====================================================
# Metadata
# =====================================================

/dev/block/by-name/metadata   /metadata   ext4 \
    noatime,nosuid,nodev,discard \
    wait,check,formattable,first_stage_mount

# =====================================================
# Data
# =====================================================

/dev/block/by-name/userdata   /data   f2fs \
    noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt \
    wait,check,formattable,quota,latemount,reservedsize=128m,readahead_size_kb=512,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption

# =====================================================
# MTK Persistent Partitions
# =====================================================

/dev/block/by-name/persist    /mnt/vendor/persist    ext4 \
    noatime,nosuid,nodev,noauto_da_alloc \
    wait,check,formattable

/dev/block/by-name/nvdata     /mnt/vendor/nvdata     ext4 \
    noatime,nosuid,nodev,noauto_da_alloc \
    wait,check,formattable

/dev/block/by-name/nvcfg      /mnt/vendor/nvcfg      ext4 \
    noatime,nosuid,nodev,noauto_da_alloc \
    wait,check,formattable

/dev/block/by-name/protect1   /mnt/vendor/protect_f  ext4 \
    noatime,nosuid,nodev,noauto_da_alloc \
    wait,check,formattable

/dev/block/by-name/protect2   /mnt/vendor/protect_s  ext4 \
    noatime,nosuid,nodev,noauto_da_alloc \
    wait,check,formattable

# =====================================================
# Boot Partitions
# =====================================================

/dev/block/by-name/boot_a          /boot          emmc    defaults    slotselect
/dev/block/by-name/vendor_boot_a   /vendor_boot   emmc    defaults    slotselect
/dev/block/by-name/dtbo_a          /dtbo          emmc    defaults    slotselect
/dev/block/by-name/vbmeta_a        /vbmeta        emmc    defaults    slotselect

# =====================================================
# Misc
# =====================================================

/dev/block/by-name/misc   /misc   emmc   defaults   defaults
